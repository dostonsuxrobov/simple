{
  "name": "simple-docs",
  "version": "1.0.0",
  "description": "A fast, local-first DOCX editor for Windows.",
  "author": "Simple Docs",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "vite build",
    "build": "npm run build:web && node scripts/prepare-portable-build.cjs && electron-builder --win portable --x64",
    "build:dir": "npm run build:web && electron-builder --win dir --x64",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forevka/wordcanvas": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.simple.docs",
    "productName": "Simple Docs",
    "asar": true,
    "electronLanguages": ["en-US"],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "portable": {
      "useZip": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Simple-Docs-${version}-portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word document",
        "description": "Word document",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  }
}
