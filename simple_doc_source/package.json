{
  "name": "simple-docs",
  "version": "1.0.0",
  "description": "A fast, local-first Word editor for DOCX and legacy DOC files on Windows.",
  "author": "Simple Docs",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-wordcanvas.cjs",
    "pretest": "node scripts/patch-wordcanvas.cjs",
    "prebuild:web": "node scripts/patch-wordcanvas.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "vite build",
    "build": "npm run test && npm run build:web && node scripts/prepare-portable-build.cjs && electron-builder --win portable --x64",
    "build:dir": "npm run test && npm run build:web && electron-builder --win dir --x64",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test tests/*.test.cjs && node scripts/test-wordcanvas-patch.mjs",
    "test:print:ui": "node scripts/run-print-dialog-smoke.mjs",
    "test:print:host": "electron scripts/run-print-host-smoke.cjs",
    "test:fidelity": "node scripts/run-document-fidelity-smoke.mjs",
    "test:editor:stress": "node scripts/run-editor-stress.mjs"
  },
  "dependencies": {
    "@forevka/wordcanvas": "0.12.0",
    "cfb": "1.2.2",
    "jszip": "^3.10.1",
    "markdown-it": "14.3.2",
    "pdf-lib": "1.17.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.simple.docs",
    "productName": "Simple Docs",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "portable": {
      "useZip": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Simple-Docs-${version}-portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "docx",
          "doc"
        ],
        "name": "Word document",
        "description": "Word document",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  }
}
